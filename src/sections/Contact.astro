---
import Toast from "../components/Toast.astro";
import ContactForm from "../components/ContactForm.astro";
---

<div
    class="flex flex-col items-center justify-center py-12 px-4 relative overflow-hidden"
>
    <h2
        class="font-bold text-slate-50 text-4xl md:text-6xl py-12 scroll-fade-up text-center"
    >
        Contacto
    </h2>

    <div
        class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 bg-amber-950/60 -z-10 rounded-full w-80 h-80 md:w-150 md:h-150 lg:w-225 lg:h-225"
        style="filter: blur(120px)"
    >
    </div>

    <Toast />

    <div class="w-full flex justify-center">
        <ContactForm />
    </div>
</div>
