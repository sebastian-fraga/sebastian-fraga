---
import AboutCard from "../components/AboutCard.astro";
---

<div
    class="flex flex-col items-center justify-center min-h-screen py-12 relative overflow-hidden"
>
    <h2
        class="font-bold text-slate-50 text-4xl md:text-6xl py-12 scroll-fade-up"
    >
        Sobre mí
    </h2>

    <div
        class="absolute top-1/2 left-1/2
               -translate-x-1/2 -translate-y-1/2
               bg-amber-950/60 -z-10 rounded-full
               w-80 h-80
               md:w-150 md:h-150
               lg:w-225 lg:h-225"
        style="filter: blur(120px)"
    >
    </div>

    <div class="w-full px-4 md:px-0 flex justify-center">
        <AboutCard />
    </div>
</div>
