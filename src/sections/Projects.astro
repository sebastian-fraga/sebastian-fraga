---

<div
    class="flex flex-col items-center justify-center min-h-screen py-12 relative"
>
    <h2 class="font-bold text-slate-50 text-6xl py-12 ">Proyectos destacados</h2>
    <div
        class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 bg-amber-950/60 -z-10 rounded-full w-225 h-225"
        style="filter: blur(120px)"
    >
    </div>

    <div class="grid grid-cols-2 gap-x-12 gap-y-10 relative ">
        {projects.map((project) => <ProjectCard {...project} />)}
    </div>

    <dialog
        id="project-dialog"
        class="fixed mx-auto my-auto rounded-2xl border-2 border-black/95 py-4 w-290 h-140 drop-shadow-2xl transition-all overflow-hidden"
    >
        <div
            id="dialog-gradient"
            class="rounded-xl absolute inset-0 h-full -z-10"
        >
        </div>
        <div class="grid grid-cols-[2fr_1fr] h-full pl-5 relative">
            <div class="flex flex-col items-center gap-4 px-12 h-full min-h-0">
                <div class="rounded-2xl mt-8 mx-auto shrink-0">
                    <Swiper />
                </div>

                <div
                    class="scroll-text flex-1 min-h-0 overflow-y-auto pr-2 py-5 flex flex-col gap-4 font-medium text-md/7 max-w-[60ch]"
                >
                    <p
                        id="dialog-text-1"
                        class="text-lg/7 font-medium text-slate-900"
                    >
                    </p>
                    <p
                        id="dialog-text-2"
                        class="text-md/7 font-medium text-slate-800"
                    >
                    </p>
                    <p
                        id="dialog-text-3"
                        class="text-md/7 font-medium text-slate-800"
                    >
                    </p>
                </div>
            </div>
            <aside class="flex flex-col relative h-full pl-7 pr-3">
                <div class="aside-header relative mt-8 pb-3">
                    <h2 class="text-4xl text-start mb-2" id="dialog-name"></h2>
                    <p
                        class="text-sm max-w-prose text-gray-700 text-pretty text-start italic"
                        id="dialog-description"
                    >
                    </p>
                </div>
                <div
                    class="flex items-center justify-center gap-6 mt-2 py-4 border-y border-black/10"
                >
                    <div class="flex items-center gap-0.5">
                        <CalendarIcon />
                        <span class="text-sm font-medium" id="dialog-year"
                        ></span>
                    </div>

                    <div class="flex items-center gap-0.5">
                        <StatusIcon class="text-green-500" />
                        <span class="text-sm font-medium" id="dialog-status"
                        ></span>
                    </div>
                </div>
                <div class="flex flex-col flex-1 mt-3 z-10">
                    <h3 class="text-xl font-semibold mb-2">TECNOLOGÍAS</h3>
                    <div
                        class="grid grid-cols-3 gap-y-2 gap-x-1 mb-4"
                        id="dialog-stack"
                    >
                    </div>

                    <div class="flex flex-col w-full gap-2 mt-auto pb-7 z-10">
                        <Button as="a" id="dialog-url" variant="primary" target="_blank" rel="noopener noreferrer">
                            <ExternalIcon slot="icon" />
                            <span id="dialog-url-label">Visitar página</span>
                            <div></div>
                        </Button>

                        <Button as="a" id="dialog-repo" variant="ghost" target="_blank" rel="noopener noreferrer">
                            <GithubIcon slot="icon" />
                            Ver código
                            <div></div>
                        </Button>
                    </div>
                </div>
                <img
                    id="dialog-aside-logo"
                    src=""
                    alt=""
                    class="absolute bottom-0 right-0 w-64 h-64 object-contain opacity-5 pointer-events-none select-none z-0"
                    loading="lazy"
                />
            </aside>
            <div
                class="absolute top-0 right-3.5 text-gray-600/70 hover:text-red-500/50 transition-colors cursor-pointer"
                id="closeBtn"
            >
                <CloseIcon />
            </div>
        </div>
    </dialog>
</div>

<style>
    .scroll-text {
        --sb-track-color: transparent;
        --sb-thumb-color: #ff7b00;
        --sb-size: 5px;
        -webkit-mask-image: linear-gradient(
            to bottom,
            transparent 0%,
            black 8%,
            black 92%,
            transparent 100%
        );
        mask-image: linear-gradient(
            to bottom,
            transparent 0%,
            black 8%,
            black 92%,
            transparent 100%
        );
        -webkit-mask-attachment: local;
        mask-attachment: local;
    }

    .scroll-text::-webkit-scrollbar {
        width: var(--sb-size);
    }

    .scroll-text::-webkit-scrollbar-track {
        background: var(--sb-track-color);
        border-radius: 3px;
    }

    .scroll-text::-webkit-scrollbar-thumb {
        background: var(--sb-thumb-color);
        border-radius: 3px;
    }

    @supports not selector(::-webkit-scrollbar) {
        .scroll-text {
            scrollbar-color: var(--sb-thumb-color) var(--sb-track-color);
        }
    }

    dialog {
        opacity: 0;
        transform: scale(0.95) translateY(8px);
        transition:
            opacity 0.25s ease,
            transform 0.25s ease,
            display 0.25s allow-discrete,
            overlay 0.25s allow-discrete;
    }

    dialog[open] {
        opacity: 1;
        transform: scale(1) translateY(0);
    }

    @starting-style {
        dialog[open] {
            opacity: 0;
            transform: scale(0.95) translateY(8px);
        }
    }

    dialog::backdrop {
        background: transparent;
        backdrop-filter: blur(0px) brightness(1);
        transition:
            background 0.25s ease,
            backdrop-filter 0.25s ease,
            overlay 0.25s allow-discrete,
            display 0.25s allow-discrete;
    }

    dialog[open]::backdrop {
        background: rgba(0, 0, 0, 0.3);
        backdrop-filter: blur(6px) brightness(0.6);
    }

    @starting-style {
        dialog[open]::backdrop {
            background: transparent;
            backdrop-filter: blur(0px) brightness(1);
        }
    }

    aside::before {
        content: "";
        top: 0;
        left: 0;
        position: absolute;
        background: #00000038;
        width: 1px;
        height: 100%;
    }
</style>

<script>
    const dialog = document.getElementById(
        "project-dialog",
    ) as HTMLDialogElement;
    const cards = document.querySelectorAll("article[data-name]");
    const closeBtn = document.getElementById("closeBtn");

    dialog.addEventListener("click", (e) => {
        if (e.target === dialog) {
            dialog.close();
        }
    });

    closeBtn?.addEventListener("click", () => {
        dialog.close();
    });

    dialog.addEventListener("close", () => {
        document.body.style.overflow = "";
    });

    cards.forEach((card) => {
        card.addEventListener("click", () => {
            const {
                screenshots,
                text1,
                text2,
                text3,
                logo,
                name,
                description,
                year,
                status,
                url,
                urlLabel,
                repo,
                gradientFrom,
                gradientTo,
                stack,
                nameStyle,
                fontUrl,
            } = (card as HTMLElement).dataset;

            const scrollText = document.querySelector(
                ".scroll-text",
            ) as HTMLElement;
            scrollText.style.setProperty("--sb-thumb-color", gradientFrom!);

            if (fontUrl && !document.querySelector(`link[href="${fontUrl}"]`)) {
                const link = document.createElement("link");
                link.rel = "stylesheet";
                link.href = fontUrl;
                document.head.appendChild(link);
            }

            const swiperWrapper = document.querySelector(".swiper-wrapper")!;
            swiperWrapper.innerHTML = "";

            JSON.parse(screenshots!).forEach((src: string) => {
                const slide = document.createElement("div");
                slide.className = "swiper-slide";
                slide.innerHTML = `<img src="${src}" alt="" loading="lazy"/>`;

                swiperWrapper.appendChild(slide);
            });

            document.getElementById("dialog-text-1")!.innerHTML = text1 ?? "";
            document.getElementById("dialog-text-2")!.innerHTML = text2 ?? "";
            document.getElementById("dialog-text-3")!.innerHTML = text3 ?? "";

            document.getElementById("dialog-year")!.textContent = year!;
            document.getElementById("dialog-status")!.textContent = status!;

            const dialogName = document.getElementById("dialog-name")!;
            dialogName.textContent = name!;
            dialogName.style.cssText = nameStyle ?? "";

            const asideLogo = document.getElementById(
                "dialog-aside-logo",
            ) as HTMLImageElement;
            asideLogo.src = logo ?? "";
            asideLogo.style.display = logo ? "block" : "none";

            document.getElementById("dialog-description")!.textContent =
                description!;

            document.getElementById("dialog-url-label")!.textContent =
                urlLabel ?? "Visitar página";
            (document.getElementById("dialog-url") as HTMLAnchorElement).href =
                url!;
            (document.getElementById("dialog-repo") as HTMLAnchorElement).href =
                repo!;
            document.getElementById("dialog-gradient")!.style.background =
                `linear-gradient(135deg, ${gradientFrom}, ${gradientTo})`;

            const stackContainer = document.getElementById("dialog-stack")!;
            stackContainer.innerHTML = "";

            JSON.parse(stack!).forEach((tech: string) => {
                const badge = document.createElement("div");
                badge.className =
                    "flex items-center gap-x-2 rounded-md bg-black/15 backdrop-blur-sm px-3 py-2 border-1 border-black/10";
                badge.innerHTML = `
                <img src="/projects/icons/${tech.toLowerCase()}.svg" alt="${tech}" width="16" height="16" class="shrink-0 invert" loading="lazy"/>
                <span class="font-thin text-sm text-slate-50">${tech}</span>
            `;
                stackContainer.appendChild(badge);
            });

            dialog.showModal();
            document.body.style.overflow = "hidden";
        });
    });
</script>
