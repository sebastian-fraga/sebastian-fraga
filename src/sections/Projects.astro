---
import ProjectCard from "../components/ProjectCard.astro";
import Swiper from "../components/Swiper.astro";
import Button from "../components/Button.astro";

import CloseIcon from "../components/icons/CloseIcon.astro";
import CalendarIcon from "../components/icons/CalendarIcon.astro";
import StatusIcon from "../components/icons/StatusIcon.astro";
import ExternalIcon from "../components/icons/ExternalIcon.astro";
import GithubIcon from "../components/icons/GithubIcon.astro";

const projects = [
    {
        image: "/projects/viceclub.webp",
        alt: "Captura de Vice Club",
        gradientFrom: "#8F7EDD",
        gradientTo: "#F9C9F0",
        screenshots: [
            "/projects/viceclub/1.webp",
            "/projects/viceclub/2.webp",
            "/projects/viceclub/3.webp",
            "/projects/viceclub/4.webp",
            "/projects/viceclub/5.webp",
        ],
        text1: "Mi primer gran proyecto. Se trata de una wiki con información, guías y herramientas para cada uno de los juegos principales de la <b>saga Grand Theft Auto</b>. El sitio utiliza rutas dinámicas para reutilizar contenido y mantener una estructura consistente entre todas las secciones.",
        text2: "Originalmente comenzó como un proyecto desarrollado con HTML, CSS y JavaScript vanilla. Sin embargo, a medida que la cantidad de páginas crecía, decidí <b>migrarlo a Astro</b> para mejorar la mantenibilidad, la reutilización de componentes y la experiencia de desarrollo.",
        text3: "Actualmente cuenta con <b>dominio propio</b>, despliegue en Vercel y recibe cerca de <b>50 visitas mensuales</b> provenientes principalmente de usuarios de Latinoamérica.",
        name: "Vice Club",
        nameStyle:
            "font-family: 'Alfa Slab One', sans-serif; color: #4d9eff; text-transform: uppercase; -webkit-text-stroke: 2px rgba(0, 0, 0, 0.698)",
        fontUrl:
            "https://fonts.googleapis.com/css2?family=Alfa+Slab+One&display=swap",
        description: "El sitio web ideal para los fanáticos de la saga GTA",
        year: "Nov. 2025 — Ahora",
        status: "En desarrollo",
        stack: [
            "Astro",
            "CSS",
            "JavaScript",
            "JSON",
            "AWS",
            "Vercel",
            "Inkscape",
        ],
        logo: "/projects/viceclub/logo.webp",
        url: "https://viceclub.app",
        repo: "https://github.com/sebastian-fraga/viceclub",
    },
    {
        image: "/projects/gabba.webp",
        alt: "Captura de Gabba",
        gradientFrom: "#94b88c",
        gradientTo: "#5ca34b",
        screenshots: [
            "/projects/gabba/1.webp",
            "/projects/gabba/2.webp",
            "/projects/gabba/3.webp",
            "/projects/gabba/4.webp",
            "/projects/gabba/5.webp",
        ],
        text1: "Aplicación móvil desarrollada con React y empaquetada para Android mediante Capacitor. Utiliza React Router para gestionar la navegación entre pantallas e integra notificaciones push a través de Firebase Cloud Messaging (FCM).",
        text2: "Gabba es una aplicación que centraliza la información de los videos y programas de Gabba Gabba Radio y Gabba Gabba Live, además de brindar acceso a la información de eventos relacionados con la Gabba Gabba Fest",
        text3: "Actualmente se encuentra publicada en Google Play, donde cuenta con más de 50 descargas y una valoración promedio de 5 estrellas.",
        name: "Gabba",
        nameStyle:
            "font-family: 'Inter', sans-serif; text-transform: uppercase; color: #AFFC41; font-weight: 900",
        fontUrl: "https://fonts.googleapis.com/css2?family=Inter&display=swap",
        description: "App ramonera",
        year: "Nov. 2025 — Ene. 2026",
        status: "Publicada",
        stack: [
            "React",
            "Tailwind",
            "JavaScript",
            "JSON",
            "AWS",
            "Admob",
            "Firebase",
            "Capacitor",
        ],
        logo: "/projects/gabba/logo.webp",
        url: "https://play.google.com/store/apps/details?id=com.gabba.app",
        urlLabel: "Descargar en Google Play",
        repo: "https://github.com/sebastian-fraga/gabba",
    },
    {
        image: "/projects/sebaweather.webp",
        alt: "Captura de SebaWeather",
        gradientFrom: "#B884B0",
        gradientTo: "#6493ed",
        screenshots: [
            "/projects/sebaweather/1.webp",
            "/projects/sebaweather/2.webp",
        ],
        text1: "Aplicación web para consultar el pronóstico del clima en cualquier ubicación del mundo.",
        text2: "Integra la API gratuita de WeatherAPI para mostrar el pronóstico de las próximas 4 horas y los 2 días siguientes. Permite también guardar ciudades en favoritos mediante localStorage.",
        name: "SebaWeather",
        nameStyle:
            "font-family: 'Inter', sans-serif; color: #f2f2f2; font-weight: 900",
        fontUrl: "https://fonts.googleapis.com/css2?family=Inter&display=swap",
        description: "Pronóstico del tiempo",
        year: "Oct. 2025",
        status: "Publicada",
        stack: ["HTML", "CSS", "JavaScript", "API"],
        logo: "/projects/sebaweather/logo.webp",
        url: "https://sebaweather.vercel.app/",
        repo: "https://github.com/sebastian-fraga/sebaweather",
    },
    {
        image: "/projects/passwordgenerator.webp",
        alt: "Captura de Password Generator",
        gradientFrom: "#87acc7",
        gradientTo: "#837ba8",
        screenshots: ["/projects/passwordgenerator/1.webp"],
        text1: "Una pequeña aplicación web que genera contraseñas seguras de forma automática mediante diversas opciones de personalización.",
        text2: "Permite ajustar la longitud y elegir el uso de mayúsculas, números y caracteres especiales para luego copiar el resultado al portapapeles con un solo click.",
        name: "Password Generator",
        nameStyle:
            "font-family: 'Inter', sans-serif; color: oklch(98.4% 0.003 247.858); font-weight: 900",
        fontUrl: "https://fonts.googleapis.com/css2?family=Inter&display=swap",
        description: "Generador de contraseñas",
        year: "Sep. 2025",
        status: "Publicada",
        stack: ["React", "Tailwind", "JavaScript"],
        logo: "/projects/passwordgenerator/logo.webp",
