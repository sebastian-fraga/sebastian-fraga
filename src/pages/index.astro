---
import Layout from "../layouts/Layout.astro";

import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";

import Home from "../sections/Home.astro";
import Projects from "../sections/Projects.astro";
import About from "../sections/About.astro";
import Contact from "../sections/Contact.astro";

import "../scripts/scroll-animations";
---

<Layout>
    <Header />
    <main class="flex flex-col">
        <section class="min-h-screen" id="home">
            <Home />
        </section>
        <section class="min-h-screen" id="projects">
            <Projects />
        </section>
        <section class="min-h-screen" id="about">
            <About />
        </section>
        <section class="min-h-screen" id="contact">
            <Contact />
        </section>
        <Footer />
    </main>
</Layout>
