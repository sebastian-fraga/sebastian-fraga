---
import "../styles/global.css";
import "@fontsource-variable/figtree/wght.css";
---

<!doctype html>
<html lang="es">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width" />
        <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
        <link rel="icon" href="/favicon.ico" />
        <meta name="generator" content={Astro.generator} />
        <title>Portfolio de Sebastián Fraga</title>
        <style>
            body {
                --sb-track-color: #232e33;
                --sb-thumb-color: #ffba7a;
                --sb-size: 5px;
            }

            body::-webkit-scrollbar {
                width: var(--sb-size);
            }

            body::-webkit-scrollbar-track {
                background: var(--sb-track-color);
                border-radius: 3px;
            }

            body::-webkit-scrollbar-thumb {
                background: var(--sb-thumb-color);
                border-radius: 3px;
            }

            @supports not selector(::-webkit-scrollbar) {
                body {
                    scrollbar-color: var(--sb-thumb-color) var(--sb-track-color);
                }
            }
        </style>
    </head>
    <body
        class="bg-neutral-950 bg-[radial-gradient(ellipse_80%_80%_at_50%_-20%,rgba(120,119,198,0.3),rgba(255,255,255,0))] min-h-screen"
    >
        <slot />
    </body>
    <script>
        import "../scripts/scroll-animations.ts";
    </script>
</html>
