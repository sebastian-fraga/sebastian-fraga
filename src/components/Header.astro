---
import HamburgerIcon from "./icons/HamburgerIcon.astro";
import SunIcon from "./icons/SunIcon.astro";
import LangIcon from "./icons/LangIcon.astro";
---

<header
    class="flex justify-between items-center
    w-[95vw] md:w-[80vw]
    h-18 md:h-25
    px-4 md:px-11
    mx-auto
    border-2 border-slate-300/40
    rounded-3xl md:rounded-[38px]
    bg-slate-300/30
    absolute top-4 md:top-8 left-0 right-0
    backdrop-blur-2xl backdrop-brightness-50
    z-100"
>
    <span class="font-bold text-lg sm:text-2xl md:text-4xl text-white">
        Sebastián Fraga
    </span>

    <div class="flex items-center gap-3 md:gap-6.5">
        <button
            id="menuToggle"
            class="md:hidden text-white text-3xl"
            aria-label="Abrir menú"
        >
            <HamburgerIcon />
        </button>

        <nav class="hidden md:flex gap-6 text-xl text-white">
            <a href="#home">Inicio</a>
            <a href="#projects">Proyectos</a>
            <a href="#about">Sobre mí</a>
            <a href="#contact">Contacto</a>
        </nav>

        <nav
            id="mobileMenu"
            class="absolute top-full left-0 right-0 mt-3 text-white bg-slate-900/90 backdrop-blur-xl rounded-3xl border border-slate-300/30 flex flex-col items-center gap-4 py-6 hidden"
        >
            <a href="#home">Inicio</a>
            <a href="#projects">Proyectos</a>
            <a href="#about">Sobre mí</a>
            <a href="#contact">Contacto</a>
        </nav>

        <div class="flex gap-3 md:gap-5 text-white">
            <button id="appearanceToggle">
                <SunIcon />
            </button>
            <button id="langToggle">
                <LangIcon />
            </button>
        </div>
    </div>
</header>

<style>
    header {
        opacity: 0;
        pointer-events: none;

        &.animated {
            animation: slideDown 0.35s ease-out;
        }

        &.is-sticky {
            position: fixed;
            top: 2rem;
            left: 0;
            right: 0;
            width: 95vw;
            margin: 0 auto;
            transition: opacity 0.2s ease;
            opacity: 1;
            pointer-events: all;
        }
    }

    @media (min-width: 768px) {
        header.is-sticky {
            width: 80vw;
        }
    }

    nav a:not(.active) {
        font-weight: 100;
        transition: all 0.4s ease-out;

        &:hover {
            color: #ffcea2;
        }
    }

    nav a.active {
        color: #ffcea2;
        font-weight: 600;
        transition: all 0.4s ease-out;
    }

    @keyframes slideDown {
        from {
            transform: translateY(-100%);
        }
        to {
            transform: translateY(0);
        }
    }
</style>

<script>
    const menuToggle = document.getElementById("menuToggle");
    const mobileMenu = document.getElementById("mobileMenu");

    menuToggle?.addEventListener("click", () => {
        mobileMenu?.classList.toggle("hidden");
    });

    const menuLinks = document.querySelectorAll("#mobileMenu a");

    menuLinks.forEach((link) => {
        link.addEventListener("click", () => {
            mobileMenu?.classList.add("hidden");
        });
    });

    window.addEventListener("resize", () => {
        if (window.innerWidth >= 768) {
            mobileMenu?.classList.add("hidden");
        }
    });
</script>

<script>
    const header = document.querySelector("header");
    const sections = document.querySelectorAll("section[id]");
    const navLinks = document.querySelectorAll("nav a");

    function addAnimationClass() {
        header?.classList.remove("animated");
        void header?.offsetWidth;
        header?.classList.add("animated");
    }

    window.addEventListener("scroll", () => {
        const currentScroll = window.pageYOffset;
        if (currentScroll > 100) {
            if (!header?.classList.contains("is-sticky")) {
                header?.classList.add("is-sticky");
                addAnimationClass();
            }
        } else {
            header?.classList.remove("is-sticky");
            header?.classList.remove("animated");
        }
    });

    const observer = new IntersectionObserver(
        (entries) => {
            entries.forEach((entry) => {
                const link = document.querySelector(
                    `nav a[href="#${entry.target.id}"]`,
                );
                if (entry.isIntersecting) {
                    navLinks.forEach((l) => l.classList.remove("active"));
                    link?.classList.add("active");
                }
            });
        },
        { threshold: 0.3 },
    );

    sections.forEach((section) => observer.observe(section));
</script>
