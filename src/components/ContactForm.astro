<div
    class="bg-linear-135 from-[#F4AC46] to-[#462e17]
    rounded-3xl
    w-full max-w-270
    text-slate-50
    drop-shadow-2xl
    grid grid-cols-1
    lg:grid-cols-[1.1fr_1px_0.9fr]
    gap-8
    px-5 py-6
    md:px-8 md:py-8
    lg:px-12.5 lg:py-10"
>
    <div class="flex flex-col gap-8 lg:justify-between">
        <div class="flex flex-col gap-8 lg:gap-12">
            <h3 class="font-semibold text-3xl md:text-4xl">
                ¿Tienes un proyecto en mente?
            </h3>

            <p
                class="text-lg md:text-2xl leading-8 md:leading-9 font-light max-w-[30ch] text-pretty"
            >
                Puedo ayudarte a construir interfaces rápidas, accesibles y con
                atención al detalle.
            </p>
        </div>

        <div class="flex items-center gap-2.5 text-amber-100">
            <span class="font-semibold text-xl md:text-2xl">✦</span>
            <p class="font-regular text-base md:text-xl">¡Respuesta en 24hs!</p>
        </div>
    </div>

    <div
        class="hidden lg:block bg-linear-180 from-transparent via-slate-100/20 to-transparent h-full rounded-full"
    >
    </div>

    <div class="text-black">
        <form
            id="contactForm"
            action=""
            class="w-full bg-white rounded-[30px] px-5 pt-6 pb-5 flex flex-col gap-6"
            autocomplete="off"
        >
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                <div class="relative">
                    <label for="firstName" class="floating-label">
                        Nombre
                        <span class="text-red-400">*</span>
                    </label>

                    <input
                        id="firstName"
                        name="firstName"
                        type="text"
                        class="custom-box w-full"
                        required
                    />
                </div>

                <div class="relative">
                    <label for="lastName" class="floating-label">
                        Apellido
                        <span class="text-red-400">*</span>
                    </label>

                    <input
                        id="lastName"
                        name="lastName"
                        type="text"
                        class="custom-box w-full"
                        required
                    />
                </div>
            </div>

            <div class="relative">
                <label for="email" class="floating-label">
                    Correo electrónico
                    <span class="text-red-400">*</span>
                </label>

                <input
                    id="email"
                    name="email"
                    type="email"
                    class="custom-box w-full"
                    required
                />
            </div>

            <div class="relative">
                <label for="reason" class="floating-label"> Motivo </label>

                <select id="reason" name="reason" class="custom-box w-full">
                    <option value="" selected> Selecciona un motivo </option>

                    <option value="web"> Desarrollo web </option>

                    <option value="ui"> Diseño UI/UX </option>

                    <option value="maintenance"> Mantenimiento </option>

                    <option value="other"> Otro </option>
                </select>
            </div>

            <div class="relative">
                <label for="message" class="floating-label">
                    Mensaje
                    <span class="text-red-400">*</span>
                </label>

                <textarea
                    id="message"
                    name="message"
                    class="custom-box textarea-box w-full"
                    required></textarea>
            </div>

            <button
                type="submit"
                class="h-12 rounded-xl bg-slate-900 text-white font-medium hover:bg-slate-800 transition-colors cursor-pointer"
            >
                Enviar mensaje
            </button>
        </form>
    </div>
</div>

<style>
    .custom-box {
        background: #fff;
        border-radius: 10px;
        height: 36px;
        border: 1px solid #cdcdcd;
        padding-inline: 14px;
        font-size: 14px;
        font-weight: 100;
    }

    .floating-label {
        position: absolute;
        left: 12px;
        top: -12px;
        z-index: 10;
        background: #fff;
        padding-inline: 4px;
        font-size: 14px;
        font-weight: 600;
    }

    textarea {
        resize: vertical;
        min-height: 140px;
        padding-block: 8px;
    }
</style>

<script>
    import { showToast } from "../scripts/toast";

    const form = document.getElementById(
        "contactForm",
    ) as HTMLFormElement | null;

    form?.addEventListener("submit", async (e) => {
        e.preventDefault();

        const formData = new FormData(form);

        try {
            const response = await fetch("/api/contact", {
                method: "POST",
                headers: {
                    "Content-Type": "application/json",
                },
                body: JSON.stringify(Object.fromEntries(formData)),
            });

            if (!response.ok) throw new Error();

            form.reset();
            showToast("success", "Mensaje enviado correctamente");
        } catch {
            showToast("error", "Error al enviar el mensaje");
        }
    });

    (window as any).showToast = showToast;
</script>
