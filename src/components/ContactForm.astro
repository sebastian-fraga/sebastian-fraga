

<div
    class="bg-linear-135 from-[#F4AC46] to-[#462e17]
    rounded-3xl
    grid grid-cols-[1.1fr_1px_0.9fr]
    gap-x-8
    w-270 h-125
    text-slate-50
    py-10 px-12.5
    drop-shadow-2xl"
>
    <div class="flex flex-col justify-between items-start">
        <div class="flex flex-col gap-12">
            <h3 class="font-semibold text-4xl">
                ¿Tienes un proyecto en mente?
            </h3>
            <p class="text-2xl leading-9 font-light max-w-[30ch] text-pretty">
                Puedo ayudarte a construir interfaces rápidas, accesibles y con
                atención al detalle.
            </p>
        </div>
        <div class="flex items-center gap-2.5 text-amber-100">
            <span class="font-semibold text-2xl">✦</span>
            <p class="font-regular text-xl">Respuesta en 24hs!</p>
        </div>
    </div>
    <div
        class="bg-linear-180 from-transparent via-slate-100/20 to-transparent h-full rounded-full"
    >
    </div>
    <div class="h-full text-black">
        <form
            id="contactForm"
            action=""
            class="w-full h-full bg-white rounded-[30px] px-5 pt-6 pb-5 flex flex-col gap-6"
            autocomplete="off"
        >
            <div class="grid grid-cols-2 gap-4">
                <div class="relative">
                    <label for="firstName" class="floating-label">
                        Nombre
                        <span class="text-red-400">*</span>
                    </label>

                    <input
                        id="firstName"
                        name="firstName"
                        type="text"
                        class="custom-box w-full"
                        required
                    />
                </div>

                <div class="relative">
                    <label for="lastName" class="floating-label">
                        Apellido
                        <span class="text-red-400">*</span>
                    </label>

                    <input
                        id="lastName"
                        name="lastName"
                        type="text"
                        class="custom-box w-full"
                        required
                    />
                </div>
            </div>

            <div class="relative">
                <label for="email" class="floating-label">
                    Correo electrónico
                    <span class="text-red-400">*</span>
                </label>

                <input
                    id="email"
                    name="email"
                    type="email"
                    class="custom-box w-full"
                    required
                />
            </div>

            <div class="relative">
                <label for="reason" class="floating-label"> Motivo </label>

                <select id="reason" name="reason" class="custom-box w-full">
                    <option value="" selected> Selecciona un motivo </option>

                    <option value="web"> Desarrollo web </option>

                    <option value="ui"> Diseño UI/UX </option>

                    <option value="maintenance"> Mantenimiento </option>

                    <option value="other"> Otro </option>
                </select>
            </div>

            <div class="relative flex-1">
                <label for="message" class="floating-label">
                    Mensaje

                    <span class="text-red-400">*</span>
                </label>

                <textarea
                    id="message"
                    name="message"
                    class="custom-box textarea-box w-full"
                    required></textarea>
            </div>

            <button
                type="submit"
                class="h-12 rounded-xl bg-slate-900 text-white font-medium hover:bg-slate-800 transition-colors cursor-pointer"
            >
                Enviar mensaje
            </button>
        </form>
    </div>
</div>

<style>
    .custom-box {
        background: #fff;
        border-radius: 10px;
        height: 36px;
        border: 1px solid #cdcdcd;
        padding-inline: 14px;
        font-size: 14px;
        font-weight: 100;
    }

    .floating-label {
        position: absolute;
        left: 12px;
        top: -12px;
        z-index: 10;
        background: #fff;
        padding-inline: 4px;
        font-size: 14px;
        font-weight: 600;
    }
    textarea {
        resize: none;
        height: 100% !important;
        padding-block: 8px;
    }
</style>

<script type="module">
    import { showToast } from "/src/scripts/toast";

    const form = document.getElementById("contactForm");

    form?.addEventListener("submit", async (e) => {
        e.preventDefault();

        const formData = new FormData(form);

        try {
            const response = await fetch("/api/contact", {
                method: "POST",
                headers: {
                    "Content-Type": "application/json",
                },
                body: JSON.stringify(Object.fromEntries(formData)),
            });

            if (!response.ok) {
                throw new Error();
            }

            form.reset();

            showToast("success", "Mensaje enviado correctamente");
        } catch {
            showToast("error", "Error al enviar el mensaje");
        }
    });
</script>
